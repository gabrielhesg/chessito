# Chessito · variables de entorno
#
# Copiar a .env.local para trabajar en local. NUNCA commitear .env.local.
# El unico archivo que lee estas variables es lib/env.ts. Ver docs/ENVIRONMENTS.md
# para que valor va en que ambiente.

# --- Supabase ---------------------------------------------------------------
# Dashboard de Supabase > Settings > API
# Sin prefijo NEXT_PUBLIC_ a proposito: la app no tiene componentes cliente y estos valores
# no viajan al navegador. Ver la nota en lib/env.ts.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=

# Settings > API > service_role. NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Settings > Database > Connection string (URI). Solo la usan los scripts batch
# y la generacion de tipos. No la necesita la app en Vercel.
SUPABASE_DB_URL=

# --- Aplicacion -------------------------------------------------------------
# Usuario de chess.com cuyo historico se ingiere.
CHESSCOM_USERNAME=gabrielhesg

# Unico email autorizado a entrar. El middleware rechaza cualquier otro.
OWNER_EMAIL=

# Secreto que protege GET /api/ingest. Vercel lo manda solo como
# "Authorization: Bearer <CRON_SECRET>" en sus crons. Distinto por ambiente.
CRON_SECRET=

# --- Opcionales -------------------------------------------------------------
# Fuerza el nombre de ambiente ('prod' | 'dev'). En Vercel se deriva de VERCEL_ENV;
# en GitHub Actions y en local hay que declararlo.
APP_ENV=dev
